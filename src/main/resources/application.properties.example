# Spring Application Configuration
spring.application.name=call_outcome

# OpenAI API Configuration
# REQUIRED: You must set your OpenAI API key in one of the following ways:
# 1. Environment variable: export OPENAI_API_KEY=your-api-key-here
# 2. Direct value (not recommended for production): spring.ai.openai.api-key=your-api-key-here
# 3. System property: -DOPENAI_API_KEY=your-api-key-here
spring.ai.openai.api-key=${OPENAI_API_KEY}

# OpenAI Model Configuration
# Specify the OpenAI model to use (e.g., gpt-4o, gpt-4, gpt-3.5-turbo)
spring.ai.openai.model=gpt-4o

# OpenAI Temperature Configuration
# Controls randomness in responses (0.0 = deterministic, 1.0 = more random)
spring.ai.openai.temperature=0.7
